generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Channel {
  WHATSAPP @map("whatsapp")
}

enum MessageRole {
  USER      @map("user")
  ASSISTANT @map("assistant")
  TOOL      @map("tool")
  SYSTEM    @map("system")
}

enum PendingActionStatus {
  PENDING   @map("pending")
  APPROVED  @map("approved")
  CANCELLED @map("cancelled")
  EXPIRED   @map("expired")
  EXECUTED  @map("executed")
  FAILED    @map("failed")
}

enum AutomationStatus {
  ACTIVE  @map("active")
  PAUSED  @map("paused")
  DELETED @map("deleted")
}

enum AutomationRunStatus {
  RUNNING @map("running")
  SUCCESS @map("success")
  FAILED  @map("failed")
  SKIPPED @map("skipped")
}

model User {
  id            String   @id @default(cuid())
  whatsappPhone String   @unique
  googleEmail   String?
  timezone      String   @default("America/New_York")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  googleAccount     GoogleAccount?
  asanaAccount      AsanaAccount?
  notionAccount     NotionAccount?
  conversations     Conversation[]
  memoryEntries     MemoryEntry[]
  contextGraphNodes ObsidianContextGraphNode[]
  pendingActions    PendingAction[]
  auditLogs         AuditLog[]
  automations       Automation[]
}

model GoogleAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  accessToken  String
  refreshToken String
  expiryDate   DateTime?
  scope        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AsanaAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  asanaUserGid String
  asanaEmail   String?
  asanaName    String?
  accessToken  String
  refreshToken String
  expiryDate   DateTime?
  scope        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotionAccount {
  id            String    @id @default(cuid())
  userId        String    @unique
  workspaceId   String?
  workspaceName String?
  workspaceIcon String?
  botId         String?
  ownerType     String?
  accessToken   String
  refreshToken  String?
  expiryDate    DateTime?
  scope         String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  channel   Channel
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       Message[]
  pendingActions PendingAction[]
  automations    Automation[]

  @@index([userId, channel])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  senderPhone    String?
  content        String
  rawPayload     Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderPhone, createdAt])
}

model PendingAction {
  id             String              @id @default(cuid())
  userId         String
  conversationId String
  actionType     String
  status         PendingActionStatus @default(PENDING)
  payload        Json
  approvalCode   String              @unique
  expiresAt      DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, conversationId, status, expiresAt])
}

model MemoryEntry {
  id         String   @id @default(cuid())
  userId     String
  key        String
  value      Json
  confidence Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model ObsidianContextGraphNode {
  id            String    @id @default(cuid())
  userId        String
  pcgId         String
  type          String
  label         String
  summary       String    @db.Text
  path          String
  aliases       Json
  sourceIds     Json
  sourcePaths   Json
  confidence    Float
  evidenceCount Int       @default(0)
  lastSeen      DateTime?
  contentHash   String
  searchText    String    @db.Text
  indexedAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pcgId])
  @@index([userId, type])
  @@index([userId, confidence])
  @@index([userId, indexedAt])
}

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  actionType      String
  toolName        String
  requestPayload  Json
  responsePayload Json?
  status          String
  errorMessage    String?
  createdAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([toolName, createdAt])
}

model Automation {
  id             String           @id @default(cuid())
  userId         String
  conversationId String?
  channel        Channel          @default(WHATSAPP)
  name           String
  prompt         String
  schedule       Json
  scheduleLabel  String
  timezone       String
  status         AutomationStatus @default(ACTIVE)
  nextRunAt      DateTime
  lastRunAt      DateTime?
  lockedAt       DateTime?
  lockedBy       String?
  lockExpiresAt  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  runs         AutomationRun[]

  @@index([status, nextRunAt])
  @@index([userId, status])
  @@index([lockExpiresAt])
}

model AutomationRun {
  id           String              @id @default(cuid())
  automationId String
  scheduledFor DateTime
  startedAt    DateTime            @default(now())
  finishedAt   DateTime?
  status       AutomationRunStatus
  outputText   String?
  errorMessage String?
  createdAt    DateTime            @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, scheduledFor])
  @@index([status, startedAt])
}
